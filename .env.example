# ============================================================
# Vayra — Gerçek AI Sağlayıcı Anahtarları
# ------------------------------------------------------------
# Bu dosyayı ".env.local" olarak kopyala ve anahtarları doldur.
# Anahtar girildiği an ilgili üretim türü GERÇEK API'ye geçer;
# boş bırakılan tür deterministik simülasyonla (demo) çalışır.
# Ürün her iki durumda da uçtan uca çalışır — hiçbir buton ölü değil.
# ============================================================

# Ses üretimi — ElevenLabs (Türkçe destekli multilingual v2)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# 3D modelleme — Meshy AI (text-to-3d + image-to-3d, PBR)
# https://www.meshy.ai/settings/api
MESHY_API_KEY=

# Görsel üretimi — OpenAI gpt-image-1
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Video üretimi — Replicate (ör. bytedance/seedance, kling)
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Kullanılacak video modeli: "owner/model:version" biçiminde
REPLICATE_VIDEO_MODEL=

# Görsel sağlayıcıları: Google Gemini (Nano Banana) ve BytePlus (Seedream).
# Boş bırakılırsa ilgili modeller "BAĞLANTI GEREKLİ" olarak görünür, demo üretim yapılır.
GEMINI_API_KEY=
BYTEPLUS_API_KEY=

# Script anahtarları (scripts/veo-*.mjs, scripts/fal-kling.mjs)
GEMINI_KEY=
FAL_KEY=

# ============================================================
# Vayra Earn — platform ve ödeme entegrasyonları
# Boş bırakılan entegrasyon simülasyonla çalışır (arayüz bunu belirtir).
# Anahtarsız gerçek çalışanlar: YouTube/TikTok/X gönderi kontrolü (oEmbed),
# NVİ T.C. kimlik doğrulama.
# ============================================================

# YouTube Data API v3 — kanal açıklaması (doğrulama kodu), abone ve video görüntülenmesi
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# X API v2 (Basic ve üzeri) — profil açıklaması, takipçi, gönderi gösterim sayısı
# https://developer.x.com/en/portal/dashboard
X_BEARER_TOKEN=

# Instagram Graph API — business_discovery ile bio + takipçi (İşletme/İçerik Üreticisi hesapları)
# META_IG_USER_ID: sorguyu yapan, Vayra'ya bağlı Instagram işletme hesabının kimliği
META_ACCESS_TOKEN=
META_IG_USER_ID=
# Instagram oEmbed (gönderi sahibi kontrolü): "APP_ID|CLIENT_TOKEN"
META_OEMBED_TOKEN=

# TikTok Research API — bio, takipçi ve video görüntülenmesi (onaylı erişim gerekir)
TIKTOK_RESEARCH_TOKEN=

# Papara toplu ödeme — kreatör çekimleri. Test için PAPARA_SANDBOX=1
PAPARA_API_KEY=
PAPARA_SANDBOX=

# ── Vayra Build (site / uygulama / oyun / mobil oluşturucu) ──
# Claude modelleri (varsayılan ajan: Claude Opus 5.5). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Tek anahtarla diğer bütün modeller (GPT, Gemini, Kimi, DeepSeek, Grok, Qwen, GLM, Mistral, MiniMax …). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# İsteğe bağlı: OpenRouter yerine başka bir OpenAI uyumlu ağ geçidi (ör. LiteLLM)
OPENROUTER_BASE_URL=
# İsteğe bağlı doğrudan sağlayıcı anahtarları (varsa OpenRouter yerine bunlar kullanılır)
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# Yayın alanı: tanımlıysa siteler <ad>.<alan> adresinde gösterilir (ör. vayra.app); boşsa bu sunucuda /b/<ad>
NEXT_PUBLIC_BUILD_ALAN=
# Özel alan adı hedefleri: kök alan adının A kaydı ve www / alt alan adlarının CNAME hedefi
BUILD_ALANADI_IP=
BUILD_ALANADI_CNAME=
# Vayra Build gizli kasası: bağlantı anahtarları ve OAuth tokenları bu anahtarla şifrelenir (AES-256-GCM).
# Boşsa ilk kullanımda .veri/build/.kasa-anahtari üretilir; üretimde mutlaka ortam değişkeni olarak ver.
VAYRA_SIFRE_ANAHTARI=
# Sistemler zamanlayıcısı: süreç içi zamanlayıcı olmayan ortamlarda (Vercel) her dakika
# GET /api/build/genel/zamanlayici çağrılır; Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Yalnız geliştirmede: localhost MCP sunucularına bağlanmaya izin ver (sahte sunucu testi).
# BUILD_MCP_YEREL=1

# ============================================================
# Yayın (sunucu) — bkz. Dockerfile ve docker-compose.yml
# Vayra sürekli çalışan tek bir Node sunucusu olarak çalışır: ajan turları dakikalarca sürer,
# sistem zamanlayıcısı arka planda döner, Build verisi diske yazılır. Kalıcı disk gerekir.
# ============================================================
# Kalıcı veri klasörü (Docker'da /veri birimi). Boşsa proje kökündeki .veri kullanılır.
VAYRA_VERI_DIZINI=
# Bu sunucunun herkese açık kök adresi (OAuth dönüş adresleri ve e-posta bağlantıları), ör. https://vayra.ai
VAYRA_KOKEN=
# Ana uygulamanın alan adları (virgülle). Bunların dışındaki alan adlarına gelen istekler yayındaki Build sitelerine yönlenir.
VAYRA_ANA_ALAN=
# E-posta (Resend): üyelik doğrulama, giriş bağlantısı, şifre sıfırlama ve bildirimler.
# Gönderen adres Resend'de doğrulanmış bir alan adından olmalı, ör. "Vayra <bildirim@vayra.ai>".
RESEND_API_KEY=
RESEND_FROM=
# İsteğe bağlı: Build sitelerinin üyelik e-postaları için ayrı gönderen (boşsa RESEND_FROM)
BUILD_EPOSTA_GONDEREN=
# Sistemlerin e-posta tetikleyicisi için gelen kutusu alan adı (ör. gelen.vayra.ai)
NEXT_PUBLIC_BUILD_EPOSTA_ALAN=
# Hediye kodlarını imzalayan gizli anahtar
VAYRA_HEDIYE_SIRRI=
# Claude anahtarı yerine Anthropic kimlik belirteci kullanılacaksa
ANTHROPIC_AUTH_TOKEN=
# Yönetim paneli yapay zekâ asistanının modeli (boşsa varsayılan)
ANTHROPIC_MODEL=
# Ek video sağlayıcıları
KLING_API_KEY=
MINIMAX_API_KEY=
# ── Hesaplar ve giriş ──
# İlk yöneticiler (virgülle; rol e-posta doğrulanınca verilir)
VAYRA_ADMIN_EPOSTALARI=
# CSRF denetiminde VAYRA_KOKEN dışında izin verilen kökenler (isteğe bağlı, virgülle)
VAYRA_IZINLI_KOKENLER=
# Yeni hesabın planı (boşsa baslangic)
VAYRA_YENI_HESAP_PLAN=
# Üretimde girişsiz Build kullanımına izin ver (önerilmez)
VAYRA_ANONIM_BUILD=
# Üretimde ödeme altyapısı yokken deneme kredi yüklemesi ve plan yükseltmesine izin ver (yalnız deneme ortamı)
VAYRA_DENEME_ODEME=
# Sosyal giriş — dönüş adresi: <VAYRA_KOKEN>/api/hesap/oauth/<google|microsoft|apple>/donus
VAYRA_GOOGLE_CLIENT_ID=
VAYRA_GOOGLE_CLIENT_SECRET=
VAYRA_MICROSOFT_CLIENT_ID=
VAYRA_MICROSOFT_CLIENT_SECRET=
VAYRA_MICROSOFT_TENANT=
VAYRA_APPLE_CLIENT_ID=
VAYRA_APPLE_TEAM_ID=
VAYRA_APPLE_KEY_ID=
VAYRA_APPLE_PRIVATE_KEY=
# ── Vayra satışları (plan, kredi, sınırsız, hız) ──
# iyzico (Türkiye): sandbox ya da canli. Bildirim adresi: <VAYRA_KOKEN>/api/odeme/bildirim/iyzico
VAYRA_IYZICO_API_KEY=
VAYRA_IYZICO_SECRET_KEY=
VAYRA_IYZICO_ORTAM=
# Stripe (yurt dışı, USD). Webhook sırrı yoksa Stripe satışı açılmaz. Webhook: <VAYRA_KOKEN>/api/odeme/bildirim/stripe
VAYRA_STRIPE_SECRET_KEY=
VAYRA_STRIPE_WEBHOOK_SECRET=
# İsteğe bağlı: dış zamanlayıcıdan POST /api/odeme/zamanlayici (sunucu zaten saatte bir kendisi denetler). En az 16 karakter.
VAYRA_ODEME_ZAMANLAYICI_SIRRI=
# ── Build > Büyüme ──
# Sosyal hesaplardan otomatik paylaşım (dönüş: <VAYRA_KOKEN>/api/build/buyume-genel/oauth/<meta|x|linkedin|tiktok>)
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# İsteğe bağlı: LinkedIn şirket sayfası izni (1), API sürümleri
LINKEDIN_KURUM_IZNI=
LINKEDIN_API_SURUM=
META_GRAPH_SURUM=
# Google İşletme Profili gönderileri
GOOGLE_ISLETME_ISTEMCI_ID=
GOOGLE_ISLETME_ISTEMCI_GIZLI=
# Yapay zekâ anılma testi (OPENAI_API_KEY ve GEMINI_API_KEY de kullanılır)
PERPLEXITY_API_KEY=
BUYUME_OPENAI_ARAMA_MODELI=
BUYUME_PERPLEXITY_MODELI=
BUYUME_GEMINI_MODELI=
# İleti Yönetim Sistemi (İYS)
IYS_KULLANICI=
IYS_SIFRE=
IYS_KOD=
IYS_MARKA_KODU=
IYS_API_ADRES=
# Tarayıcı bildirimleri (Web Push, VAPID). Build > Sohbet > Bildirim ayarlarında "Anahtar çifti üret" ile üretilir.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Kredi işlem anahtarlarının sunucu tuzu (boşsa ilk kullanımda üretilip veri dizininde saklanır; birden çok sunucuda aynı olmalı)
VAYRA_KREDI_TUZU=

# Yalnız geliştirmede: yönetim panelinde iki adımlı doğrulama şartını atlar (kapali). Üretimde yok sayılır.
VAYRA_ADMIN_IKI_ADIM=

# Figma bağlantısından site kurma (Figma kişisel erişim belirteci)
FIGMA_TOKEN=
