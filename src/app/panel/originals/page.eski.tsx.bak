"use client";

import { useState, useRef } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { useRouter } from "next/navigation";
import {
  Play, Volume2, VolumeX, Bell, Heart, X, ChevronLeft, ChevronRight, Trophy, Zap, ArrowRight, Sparkles,
} from "lucide-react";
import { toast } from "@/lib/toast";
import { onizlemeArka, saltUrl, cn } from "@/lib/utils";
import { useScrollKilit, useEscKapat } from "@/hooks/useScrollKilit";

/* ============================================================
   VAYRA ORIGINALS — Higgsfield /original-series BİREBİR (higg-originals 25 ekran).
   AI-film/dizi vitrini (Netflix + topluluk): full-bleed hero + Vayra Seçimi /
   İlk Bakış / Radarımızda / Yakında carousel'leri + Yarışma bölümü + film grid.
   Lime aksan (.sinema-kapsam). Coming Soon detay modalı. Apple-hissiyatlı kartlar.
   ============================================================ */

const LIME = "var(--sn-lime)";

type Film = { ad: string; yazar?: string; tohum: string; kat: string; ozet?: string };

const HERO = { ad: "KÖK BÖRÜ", altbaslik: "Bozkırın son avcısı", tohum: "orig-hero-kokboru", kat: "sinematik" };

const VAYRA_SECIMI: Film[] = [
  { ad: "AVCININ MASALI", tohum: "orig-huntress", kat: "sinematik" },
  { ad: "MORK", tohum: "orig-mork", kat: "soyut" },
  { ad: "CEHENNEM ÇARKI", tohum: "orig-hellgrind", kat: "sinematik" },
];

const ILK_BAKIS: Film[] = [
  { ad: "ZEPHYR", tohum: "orig-zephyr", kat: "manzara" },
  { ad: "ARENA SIFIR", tohum: "orig-arena", kat: "3d" },
  { ad: "KİRLİ CTRL", tohum: "orig-dirty", kat: "soyut" },
  { ad: "DEM", tohum: "orig-dem", kat: "portre" },
  { ad: "MISFORTUNE", tohum: "orig-misfortune", kat: "sinematik" },
];

const RADARIMIZDA: Film[] = [
  { ad: "DONMUŞ CANAVAR", tohum: "orig-frozen", kat: "manzara" },
  { ad: "ANA KAMYONCU", tohum: "orig-mother", kat: "sinematik" },
  { ad: "TAMAM TAMAM TAMAM", tohum: "orig-alright", kat: "portre" },
  { ad: "KOVA LİSTESİ", tohum: "orig-bucket", kat: "sinematik" },
  { ad: "DINOFORCE", tohum: "orig-dino", kat: "3d" },
];

const YAKINDA: Film[] = [
  { ad: "ALTIN SAAT", tohum: "orig-golden", kat: "portre", ozet: "Yalnız bir sürücü, ölmekte olan bir tuz gölünde son analog gün batımının peşinde. Kaybolmuş bir dünyanın hayatta kalan tek kaydını taşıyor." },
  { ad: "SHIBUYA'DA KAYIP", tohum: "orig-shibuya", kat: "sinematik", ozet: "Neon ışıklı bir gecede, kalabalığın içinde kaybolan bir yabancının kendini bulma hikâyesi. Şehir bir labirent, hafıza bir pusula." },
  { ad: "NEON ŞAFAK", tohum: "orig-neon", kat: "3d", ozet: "Yapay bir güneşin altında uyanan bir robotun, insanlığın son anılarını koruma görevi. Şafak sadece bir başlangıç." },
];

const KAZANANLAR: { sira: number; ad: string; yazar: string; tohum: string; kat: string }[] = [
  { sira: 1, ad: "KOMPLO TEORİSİ", yazar: "baroque_tea", tohum: "cn-conspiracy", kat: "sinematik" },
  { sira: 2, ad: "DNAsyon", yazar: "l1nkas", tohum: "cn-dnation", kat: "soyut" },
  { sira: 3, ad: "KAÇIŞ", yazar: "pastedog", tohum: "cn-escape", kat: "aksiyon" },
];

const TOPLULUK: Film[] = [
  { ad: "AKUMA", yazar: "ibupirac666", tohum: "cm-akuma", kat: "sinematik" },
  { ad: "PİRİNÇ PİÇLER", yazar: "beauchroma", tohum: "cm-brass", kat: "3d" },
  { ad: "HASAT MEVSİMİ", yazar: "gabrielbosisio", tohum: "cm-harvest", kat: "portre" },
  { ad: "MYLO THE MANY", yazar: "charming_pc", tohum: "cm-mylo", kat: "soyut" },
  { ad: "HURDA", yazar: "colormestadic", tohum: "cm-scrap", kat: "sinematik" },
  { ad: "SOLGUN SİNYAL", yazar: "feveeer", tohum: "cm-pale", kat: "soyut" },
  { ad: "GECE NÖBETİ", yazar: "tomooo", tohum: "cm-night", kat: "3d" },
  { ad: "KARINCANIN RÜYASI", yazar: "daehyeong", tohum: "cm-ant", kat: "manzara" },
];

export default function OriginalsStudyo() {
  const router = useRouter();
  const [sesli, setSesli] = useState(false);
  const [yakindaFilm, setYakindaFilm] = useState<Film | null>(null);
  // "İlgileniyorum" — gerçekten toggle'lanan yerel ilgi listesi.
  const [ilgilenilen, setIlgilenilen] = useState<Record<string, boolean>>({});
  useScrollKilit(yakindaFilm !== null);
  useEscKapat(yakindaFilm !== null, () => setYakindaFilm(null));

  const filmAc = (tohum: string) => router.push(`/panel/originals/${tohum}`);
  const contestAc = (tohum: string) => router.push(`/panel/originals/${tohum}?tur=contest`);

  return (
    <div className="sinema-kapsam min-h-[calc(100vh-3rem)] bg-[var(--sn-zemin)] text-[var(--sn-metin)]">
      {/* ═══════════ HERO (full-bleed) ═══════════ */}
      <div className="relative h-[62vh] min-h-[440px] w-full overflow-hidden">
        <span className="absolute inset-0" style={{ background: onizlemeArka(HERO.tohum, HERO.kat) }} />
        {saltUrl(onizlemeArka(HERO.tohum, HERO.kat)) && (
          // eslint-disable-next-line @next/next/no-img-element
          <img src={saltUrl(onizlemeArka(HERO.tohum, HERO.kat))} alt="" className="absolute inset-0 h-full w-full object-cover" />
        )}
        <span className="absolute inset-0 bg-gradient-to-t from-[var(--sn-zemin)] via-[var(--sn-zemin)]/30 to-transparent" />
        <span className="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent" />

        <div className="absolute bottom-14 left-8 max-w-lg sm:left-12">
          <h1 className="hf-baslik text-[44px] leading-none text-white drop-shadow-lg sm:text-[64px]" style={{ letterSpacing: "0.04em" }}>{HERO.ad}</h1>
          <p className="mt-3 text-[15px] text-white/80">{HERO.altbaslik}</p>
          <button onClick={() => filmAc(HERO.tohum)} className="hf-btn mt-5 flex items-center gap-2 rounded-full bg-white px-6 py-3 text-[15px] font-semibold text-black">
            <Play className="h-5 w-5 fill-current" /> Şimdi izle
          </button>
        </div>

        <button onClick={() => setSesli((v) => !v)} className="hf-btn glass-cip absolute bottom-6 right-8 flex h-9 w-9 items-center justify-center rounded-full text-white/80">
          {sesli ? <Volume2 className="h-4 w-4" /> : <VolumeX className="h-4 w-4" />}
        </button>

        <span className="absolute left-8 top-6 flex items-center gap-1.5 rounded-full px-3 py-1 text-[12px] font-bold text-white sm:left-12" style={{ background: "linear-gradient(135deg,#e6317a,#c1246a)" }}>
          <Sparkles className="h-3 w-3" /> %30'A KADAR İNDİRİM
        </span>
      </div>

      <div className="mx-auto max-w-[1400px] space-y-10 px-8 pb-16 pt-4">
        {/* ═══════════ PROMO BANNER ═══════════ */}
        <div className="relative overflow-hidden rounded-2xl p-6 sm:p-8" style={{ background: "linear-gradient(120deg,#e6317a,#7b4dd3 55%,#3b5bd9)" }}>
          <div className="relative z-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
            <div>
              <p className="text-[13px] font-semibold uppercase tracking-wide text-white/80">Yeni model</p>
              <h2 className="hf-baslik text-[24px] text-white sm:text-[30px]">SEEDANCE 2.0 4K İLE ÜRETMEYE BAŞLA</h2>
            </div>
            <button onClick={() => router.push("/panel/sinema")} className="hf-btn shrink-0 rounded-full bg-white px-5 py-2.5 text-[14px] font-semibold text-black">Seedance 2.0 4K&apos;yı Al</button>
          </div>
        </div>

        {/* ═══════════ VAYRA SEÇİMİ (büyük 16:9) ═══════════ */}
        <Kusak baslik="Vayra Seçimi">
          {VAYRA_SECIMI.map((f) => (
            <BuyukKart key={f.ad} f={f} onAc={() => filmAc(f.tohum)} genislik="w-[420px]" resmi />
          ))}
        </Kusak>

        {/* ═══════════ İLK BAKIŞ ═══════════ */}
        <Kusak baslik="İlk Bakış">
          {ILK_BAKIS.map((f) => (
            <BuyukKart key={f.ad} f={f} onAc={() => filmAc(f.tohum)} genislik="w-[320px]" />
          ))}
        </Kusak>

        {/* ═══════════ RADARIMIZDA ═══════════ */}
        <Kusak baslik="Radarımızda">
          {RADARIMIZDA.map((f) => (
            <BuyukKart key={f.ad} f={f} onAc={() => filmAc(f.tohum)} genislik="w-[320px]" />
          ))}
        </Kusak>

        {/* ═══════════ YAKINDA (modal açar) ═══════════ */}
        <Kusak baslik="Yakında">
          {YAKINDA.map((f) => (
            <BuyukKart key={f.ad} f={f} onAc={() => setYakindaFilm(f)} genislik="w-[360px]" rozet="YAKINDA" />
          ))}
        </Kusak>

        {/* ═══════════ YARIŞMA: Aksiyon Sahneni Yap ═══════════ */}
        <div>
          <div className="mb-4 flex items-center gap-2">
            <Trophy className="h-5 w-5" style={{ color: LIME }} />
            <h2 className="text-[19px] font-semibold">Yarışma · Aksiyon Sahneni Yap</h2>
          </div>
          {/* Top-3 kazanan */}
          <div className="mb-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
            {KAZANANLAR.map((k) => (
              <button key={k.ad} onClick={() => contestAc(k.tohum)} className="hf-kart group relative aspect-video overflow-hidden text-left">
                <span className="absolute inset-0" style={{ background: onizlemeArka(k.tohum, k.kat) }} />
                {saltUrl(onizlemeArka(k.tohum, k.kat)) && <img src={saltUrl(onizlemeArka(k.tohum, k.kat))} alt="" className="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />}
                <span className="absolute inset-0 bg-gradient-to-t from-black/85 to-transparent" />
                <span className="hf-baslik absolute right-2 top-0 text-[80px] leading-none text-white/15">{k.sira}</span>
                <span className="absolute bottom-2.5 left-3">
                  <span className="block text-[15px] font-bold text-white">{k.ad}</span>
                  <YazarRozet ad={k.yazar} />
                </span>
              </button>
            ))}
          </div>
          {/* Topluluk grid (yazar rozetli) */}
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {TOPLULUK.map((f) => (
              <button key={f.ad} onClick={() => contestAc(f.tohum)} className="hf-kart group relative aspect-video overflow-hidden text-left">
                <span className="absolute inset-0" style={{ background: onizlemeArka(f.tohum, f.kat) }} />
                {saltUrl(onizlemeArka(f.tohum, f.kat)) && <img src={saltUrl(onizlemeArka(f.tohum, f.kat))} alt="" className="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />}
                <span className="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent" />
                <span className="pointer-events-none absolute inset-0 rounded-[20px] ring-1 ring-inset ring-white/10" />
                <span className="hf-baslik absolute left-3 top-3 text-[18px] text-white drop-shadow">{f.ad}</span>
                {f.yazar && <span className="absolute bottom-2.5 left-3"><YazarRozet ad={f.yazar} /></span>}
                <span className="absolute bottom-2.5 right-3 text-[9px] font-medium uppercase tracking-wide text-white/40">Vayra AI</span>
              </button>
            ))}
          </div>
          <div className="mt-6 flex justify-center">
            <button onClick={() => toast("Daha fazla topluluk yapımı yükleniyor…")} className="hf-btn glass-cip rounded-full px-6 py-2.5 text-[14px] text-[var(--sn-metin)]">Daha fazla izle</button>
          </div>
        </div>
      </div>

      {/* ═══════════ YAKINDA DETAY MODALI ═══════════ */}
      <AnimatePresence>
        {yakindaFilm && (
          <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}
            className="fixed inset-0 z-[80] flex items-center justify-center bg-black/75 p-4 backdrop-blur-md" onClick={() => setYakindaFilm(null)}>
            <motion.div initial={{ opacity: 0, scale: 0.97, y: 12 }} animate={{ opacity: 1, scale: 1, y: 0 }} exit={{ opacity: 0, scale: 0.97, y: 12 }} onClick={(e) => e.stopPropagation()}
              className="w-full max-w-[640px] overflow-hidden rounded-[20px] border border-white/[0.08] shadow-2xl" style={{ background: "rgba(18,18,20,0.98)" }}>
              <div className="relative aspect-video w-full overflow-hidden">
                <span className="absolute inset-0" style={{ background: onizlemeArka(yakindaFilm.tohum, yakindaFilm.kat) }} />
                {saltUrl(onizlemeArka(yakindaFilm.tohum, yakindaFilm.kat)) && <img src={saltUrl(onizlemeArka(yakindaFilm.tohum, yakindaFilm.kat))} alt="" className="absolute inset-0 h-full w-full object-cover" />}
                <span className="absolute inset-0 bg-gradient-to-t from-black/85 to-transparent" />
                <button onClick={() => setYakindaFilm(null)} className="hf-btn glass-cip absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full text-white"><X className="h-4 w-4" /></button>
                <h2 className="hf-baslik absolute bottom-4 left-5 text-[32px] text-white drop-shadow-lg">{yakindaFilm.ad}</h2>
              </div>
              <div className="p-5">
                <div className="mb-4 flex items-center gap-2">
                  <button onClick={() => { toast.success("Haber verilecek 🔔", { description: `${yakindaFilm.ad} yayınlandığında bildirim al` }); }} className="hf-btn flex items-center gap-1.5 rounded-full bg-white px-4 py-2 text-[13px] font-semibold text-black"><Bell className="h-4 w-4" /> Haber ver</button>
                  {(() => {
                    const aktif = !!ilgilenilen[yakindaFilm.ad];
                    return (
                      <button onClick={() => { setIlgilenilen((p) => ({ ...p, [yakindaFilm.ad]: !aktif })); toast(aktif ? "İlgi kaldırıldı" : "İlgileniyorsun ♥"); }}
                        className={cn("hf-btn glass-cip flex items-center gap-1.5 rounded-full px-4 py-2 text-[13px]", aktif ? "text-rose-400" : "text-[var(--sn-metin)]")}>
                        <Heart className={cn("h-4 w-4", aktif && "fill-rose-400")} /> İlgileniyorum
                      </button>
                    );
                  })()}
                </div>
                <p className="text-[14px] leading-relaxed text-[var(--sn-metin-2)]">{yakindaFilm.ozet}</p>
                {(() => {
                  const idx = YAKINDA.findIndex((y) => y.ad === yakindaFilm.ad);
                  const sonraki = YAKINDA[(idx + 1) % YAKINDA.length];
                  return (
                    <button onClick={() => setYakindaFilm(sonraki)} className="mt-5 flex items-center gap-1.5 text-[13px] text-[var(--sn-metin-3)] transition-colors hover:text-white">
                      Sonraki → {sonraki.ad} <ArrowRight className="h-3.5 w-3.5" />
                    </button>
                  );
                })()}
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}

/* ── Yatay kuşak (carousel — sol/sağ kaydırma okları) ── */
function Kusak({ baslik, children }: { baslik: string; children: React.ReactNode }) {
  const ref = useRef<HTMLDivElement>(null);
  const kaydir = (yon: 1 | -1) => ref.current?.scrollBy({ left: yon * 600, behavior: "smooth" });
  return (
    <div>
      <div className="mb-3 flex items-center justify-between">
        <h2 className="text-[19px] font-semibold">{baslik}</h2>
        <div className="flex items-center gap-1.5">
          <button onClick={() => kaydir(-1)} className="hf-btn glass-cip flex h-8 w-8 items-center justify-center rounded-full text-[var(--sn-metin-2)] hover:text-white"><ChevronLeft className="h-4 w-4" /></button>
          <button onClick={() => kaydir(1)} className="hf-btn glass-cip flex h-8 w-8 items-center justify-center rounded-full text-[var(--sn-metin-2)] hover:text-white"><ChevronRight className="h-4 w-4" /></button>
        </div>
      </div>
      <div ref={ref} className="flex gap-4 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {children}
      </div>
    </div>
  );
}

/* ── Büyük 16:9 film kartı (carousel öğesi) ── */
function BuyukKart({ f, onAc, genislik, resmi, rozet }: { f: Film; onAc: () => void; genislik: string; resmi?: boolean; rozet?: string }) {
  const arka = onizlemeArka(f.tohum, f.kat);
  return (
    <button onClick={onAc} className={cn("hf-kart group relative aspect-video shrink-0 overflow-hidden text-left", genislik)}>
      <span className="absolute inset-0" style={{ background: arka }} />
      {saltUrl(arka) && <img src={saltUrl(arka)} alt="" loading="lazy" className="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />}
      <span className="absolute inset-0 bg-gradient-to-t from-black/85 to-transparent" />
      <span className="pointer-events-none absolute inset-0 rounded-[20px] ring-1 ring-inset ring-white/10" />
      <span className="hf-baslik absolute bottom-3 left-3 right-3 text-[18px] text-white drop-shadow-lg">{f.ad}</span>
      {resmi && <span className="absolute bottom-2.5 right-3 text-[9px] font-medium uppercase tracking-wide text-white/40">Vayra Orijinal Dizi</span>}
      {rozet && <span className="glass-cip absolute left-3 top-3 rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide" style={{ color: LIME }}>{rozet}</span>}
    </button>
  );
}

/* ── Yazar rozeti (lime pill + şimşek) ── */
function YazarRozet({ ad }: { ad: string }) {
  return (
    <span className="mt-1 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold" style={{ background: LIME, color: "var(--sn-lime-metin)" }}>
      <Zap className="h-2.5 w-2.5 fill-current" /> {ad}
    </span>
  );
}
