"use client";

import Link from "next/link";
import { motion } from "framer-motion";
import { ArrowUpRight, Puzzle } from "lucide-react";
import { cn } from "@/lib/utils";

/* ============================================================
   VAYRA EKLENTİLERİ — Higgsfield /plugins LİSTE (Türkçe klon)
   ------------------------------------------------------------
   `.sinema-kapsam` ile lime imza aktif olur. Her kart Apple-hissi
   `.hf-kart`; tıkla → /panel/eklentiler/[slug]. adobe + minecraft
   TAM landing; figma/davinci/chrome "Yakında" rozetli.
   ============================================================ */

type Eklenti = {
  slug: string;
  ad: string;
  ikon: string;
  etiket: string;
  aciklama: string;
  rozet: string;
  vurgu: string; // dekoratif kart gradyanı (uygulama kimliği)
  yakinda?: boolean;
};

const EKLENTILER: Eklenti[] = [
  {
    slug: "adobe",
    ad: "Adobe",
    ikon: "Ae",
    etiket: "After Effects · Premiere",
    aciklama:
      "Adobe eklentisi — After Effects & Premiere içinde AI üretim. Reframe, arka plan sil, yükselt — dışa aktarma yok.",
    rozet: "YAKINDA",
    vurgu: "linear-gradient(135deg,#1a0033 0%,#5b21b6 55%,#9d5cff 100%)",
    yakinda: true,
  },
  {
    slug: "minecraft",
    ad: "Minecraft",
    ikon: "🧱",
    etiket: "Oyun Modu",
    aciklama:
      "Minecraft eklentisi — dünyanın içinde yapı ve medya üret. Sohbete yaz, blok blok belirsin.",
    rozet: "YAKINDA",
    vurgu: "linear-gradient(135deg,#0f2b0f 0%,#3ca340 55%,#8bd84b 100%)",
    yakinda: true,
  },
  {
    slug: "figma",
    ad: "Figma",
    ikon: "F",
    etiket: "Tasarım Aracı",
    aciklama:
      "Figma eklentisi — tasarımlarına AI görsel. Tuvali terk etmeden üret ve yerleştir.",
    rozet: "YAKINDA",
    vurgu: "linear-gradient(135deg,#1e1b2e 0%,#a259ff 55%,#f24e1e 100%)",
    yakinda: true,
  },
  {
    slug: "davinci",
    ad: "DaVinci Resolve",
    ikon: "◧",
    etiket: "Renk & Kurgu",
    aciklama:
      "DaVinci Resolve — video düzenlemede AI. Renk odasında kal, ağır işi Vayra yapsın.",
    rozet: "YAKINDA",
    vurgu: "linear-gradient(135deg,#3d1400 0%,#c2410c 55%,#fb923c 100%)",
    yakinda: true,
  },
  {
    slug: "chrome",
    ad: "Chrome",
    ikon: "◉",
    etiket: "Tarayıcı Uzantısı",
    aciklama:
      "Chrome uzantısı — her yerde Vayra. Herhangi bir sekmede seç, üret, indir.",
    rozet: "YAKINDA",
    vurgu: "linear-gradient(135deg,#0a1c3d 0%,#1a73e8 55%,#34a853 100%)",
    yakinda: true,
  },
];

/**
 * Kart kabuğu — "yakında" ise gezinmeyen, imleci varsayılan bir div;
 * değilse detay sayfasına giden Link. Kilitli kartlar hafifçe soluk.
 */
function KartKabuk({ yakinda, slug, children }: { yakinda?: boolean; slug: string; children: React.ReactNode }) {
  const ortak = "hf-kart group block overflow-hidden bg-[var(--sn-yuzey)]";
  if (yakinda) {
    return (
      <div className={cn(ortak, "cursor-default opacity-75")} aria-disabled title="Yakında">
        {children}
      </div>
    );
  }
  return <Link href={`/panel/eklentiler/${slug}`} className={ortak}>{children}</Link>;
}

export default function EklentilerIndeks() {
  return (
    <div className="sinema-kapsam min-h-screen bg-[var(--sn-zemin)] px-5 py-10 md:px-10 md:py-16">
      <div className="mx-auto max-w-6xl">
        {/* Başlık bloğu */}
        <motion.div
          initial={{ opacity: 0, y: 16 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.5 }}
          className="mb-10 md:mb-14"
        >
          <div className="mb-4 inline-flex items-center gap-2 rounded-full border border-[var(--sn-kenar-2)] bg-[var(--sn-yuzey)] px-3 py-1.5 text-xs font-medium text-[var(--sn-metin-2)]">
            <Puzzle className="h-3.5 w-3.5" style={{ color: "var(--sn-lime)" }} />
            Eklentiler
          </div>
          <h1
            className="hf-baslik text-4xl md:text-6xl"
            style={{ color: "var(--sn-lime)" }}
          >
            VAYRA EKLENTİLERİ
          </h1>
          <p className="mt-4 max-w-xl text-base text-[var(--sn-metin-2)] md:text-lg">
            Vayra'yı sevdiğin araçların içine getir. Yeniden çerçeveleme, arka
            plan kaldırma, yükseltme ve daha fazlası — favori editörünün içinde.
            Kur, aç, üret.
          </p>
        </motion.div>

        {/* Kart ızgarası */}
        <div className="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {EKLENTILER.map((e, i) => (
            <motion.div
              key={e.slug}
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.45, delay: i * 0.06 }}
            >
              {/* "Yakında" eklentiler GERÇEKTEN kilitli: Link yerine buton, rota yok.
                  Önceden yakinda:true olanlar bile tıklanıp detay sayfasına gidiyordu. */}
              <KartKabuk yakinda={e.yakinda} slug={e.slug}>
                {/* Görsel banner (uygulama kimlik gradyanı + ikon) */}
                <div
                  className="relative flex aspect-[16/10] w-full items-center justify-center"
                  style={{ background: e.vurgu }}
                >
                  <div className="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
                  {/* Uygulama ikonu — beyaz cam kare */}
                  <div className="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15 text-2xl font-black text-white backdrop-blur-md ring-1 ring-white/25">
                    {e.ikon}
                  </div>
                  {/* Rozet */}
                  <span
                    className="absolute left-4 top-4 rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide"
                    style={
                      e.yakinda
                        ? { background: "rgba(255,255,255,0.15)", color: "#fff", backdropFilter: "blur(6px)" }
                        : { background: "var(--sn-lime)", color: "var(--sn-lime-metin)" }
                    }
                  >
                    {e.rozet}
                  </span>
                  {/* Ad — sol alt */}
                  <div className="absolute bottom-4 left-4">
                    <h3 className="hf-baslik text-2xl text-white">{e.ad}</h3>
                  </div>
                  {/* Hover ok */}
                  {!e.yakinda && (
                    <div className="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full glass-ikon text-white opacity-0 transition-opacity group-hover:opacity-100">
                      <ArrowUpRight className="h-4 w-4" />
                    </div>
                    )}
                </div>

                {/* Alt bilgi */}
                <div className="p-5">
                  <div
                    className="mb-1 text-xs font-medium uppercase tracking-wide"
                    style={{ color: "var(--sn-lime)" }}
                  >
                    {e.etiket}
                  </div>
                  <p className="text-sm leading-relaxed text-[var(--sn-metin-2)]">
                    {e.aciklama}
                  </p>
                </div>
              </KartKabuk>
            </motion.div>
          ))}
        </div>
      </div>
    </div>
  );
}
